# Configurações Obrigatórias - MercFlow
# Copie este arquivo para .env e preencha os valores

# === Credenciais do Administrador ===
# Username do admin (mínimo 1 caractere, sem espaços)
ADMIN_USERNAME=admin

# Senha do admin (mínimo 12 caracteres)
# IMPORTANTE: Use uma senha forte em produção!
ADMIN_PASSWORD=sua_senha_super_secreta_aqui

# === JWT ===
# Chave secreta para tokens JWT (mínimo 32 caracteres)
# IMPORTANTE: Use uma chave única e longa em produção!
JWT_SECRET=sua_chave_secreta_jwt_muito_longa_e_segura_aqui

# === Banco de Dados ===
# Valores abaixo já batem com o docker-compose.yml do projeto
# (docker compose up -d sobe um Postgres com esses usuário/senha/db).
DB_HOST=localhost
DB_PORT=5432
DB_USER=mercflow
DB_PASSWORD=mercflow
DB_NAME=mercflow

# DATABASE_URL é o que o backend efetivamente lê (config.Load exige esta
# variável, sem montá-la a partir de DB_HOST/DB_PORT/... acima). Ajuste os
# valores caso troque DB_USER/DB_PASSWORD/DB_HOST/DB_PORT/DB_NAME acima.
DATABASE_URL=postgres://mercflow:mercflow@localhost:5432/mercflow?sslmode=disable

# === Servidor ===
PORT=8080
FRONTEND_URL=http://localhost:5173

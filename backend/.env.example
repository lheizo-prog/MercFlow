# Configurações Obrigatórias - MercFlow
# Copie este arquivo para .env e preencha os valores

# === Credenciais do Administrador ===
# Username do admin (mínimo 1 caractere, sem espaços)
ADMIN_USERNAME=admin

# Senha do admin (mínimo 12 caracteres)
# IMPORTANTE: Use uma senha forte em produção!
ADMIN_PASSWORD=sua_senha_super_secreta_aqui

# === JWT ===
# Chave secreta para tokens JWT (mínimo 32 caracteres)
# IMPORTANTE: Use uma chave única e longa em produção!
JWT_SECRET=sua_chave_secreta_jwt_muito_longa_e_segura_aqui

# === Banco de Dados ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_postgres
DB_NAME=mercflow

# === Servidor ===
PORT=8080
FRONTEND_URL=http://localhost:5173
